<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@color/bg</item>
    <item name="android:statusBarColor">@color/bg</item>
    <item name="android:navigationBarColor">@color/bg</item>
    <item name="android:colorAccent">@color/accent_text</item>
    <item name="android:colorControlActivated">@color/accent_text</item>
    <item name="android:textColorPrimary">@color/text</item>
    <item name="android:textColorSecondary">@color/text_muted</item>
    <item name="android:textColorHint">@color/text_muted</item>
    <item name="android:alertDialogTheme">@style/DialogTheme</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>
  <style name="DialogTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
    <item name="android:colorAccent">@color/accent_text</item>
    <item name="android:colorBackground">@color/surface</item>
    <item name="android:textColorPrimary">@color/text</item>
    <item name="android:textColorSecondary">@color/text_muted</item>
  </style>
</resources>
